{
  "rewrites": [
    {"source": "/", "destination": "/api/proxy37"},
    {"source": "/:path*", "destination": "/api/proxy37?path=:path*"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"}
    ]}
  ]
}
