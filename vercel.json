{
  "rewrites": [
    {
      "source": "/assets/plataforma-mobile.jpg",
      "destination": "/assets/plataforma-mobile.svg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://vercel.live https://va.vercel-scripts.com; connect-src 'self' https://vitals.vercel-insights.com https://vercel.live; frame-src https://vercel.live; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/(inspira-v2-1.css|inspira-v2-1.js|favicon.svg)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=31536000, immutable"}
      ]
    }
  ]
}