{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "depaiparafilha.vercel.app"
  ],
  "redirects": [
    {
      "source": "/conselhosdeummaupai",
      "destination": "/depaiparafilha",
      "permanent": true
    },
    {
      "source": "/conselhosdeummaupai/:path*",
      "destination": "/depaiparafilha/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "depaiparafilha.vercel.app"
        }
      ],
      "destination": "/depaiparafilha/"
    },
    {
      "source": "/assets/plataforma-mobile.jpg",
      "destination": "/assets/plataforma-mobile.svg"
    }
  ]
}