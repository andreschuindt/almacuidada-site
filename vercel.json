{
  "rewrites":[
    {"source":"/","destination":"/api/proxy?path=index.html"},
    {"source":"/inspira-v2-1.css","destination":"/api/proxy?path=inspira-v2-1.css"},
    {"source":"/inspira-v2-1.js","destination":"/api/proxy?path=inspira-v2-1.js"},
    {"source":"/privacidade.html","destination":"/api/proxy?path=privacidade.html"},
    {"source":"/termos.html","destination":"/api/proxy?path=termos.html"},
    {"source":"/robots.txt","destination":"/api/proxy?path=robots.txt"},
    {"source":"/sitemap.xml","destination":"/api/proxy?path=sitemap.xml"},
    {"source":"/favicon.svg","destination":"/api/proxy?path=favicon.svg"},
    {"source":"/favicon.ico","destination":"/api/proxy?path=favicon.svg"},
    {"source":"/assets/:path*","destination":"/api/proxy?path=assets/:path*"}
  ],
  "headers":[
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},
      {"key":"X-Frame-Options","value":"DENY"}
    ]}
  ]
}